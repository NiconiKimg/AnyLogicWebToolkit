		<ActiveObjectClass>
			<Id>1787883147992</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[// 1. WebBridge.onAnyEvent: Registers an audit log for all incoming commands
webApp.dialog.getBridge().onAnyEvent((event, args) -> {
    traceln("[Java onAnyEvent Audit] Event received: " + event);
});

// 2. WebBridge.on: Programmatic subscription to a specific command
webApp.dialog.getBridge().on("auditLog", (event, args) -> {
    traceln("[Java WebBridge.on] Specific command 'auditLog' executed.");
});

// 3. Test hide() and show() from Java
webApp.dialog.getBridge().on("toggleVisibility", (event, args) -> {
    traceln("[Java] Hiding window for 2 seconds...");
    webApp.dialog.hide();
    
    // Crear un hilo temporal para volver a mostrar la ventana
    new Thread(() -> {
        try {
            Thread.sleep(2000);
            webApp.dialog.show();
            traceln("[Java] Window shown again with show().");
        } catch (Exception e) {
            e.printStackTrace();
        }
    }).start();
});

// 4. StateSync.onAnyChange: React to changes in any StateSync key
webApp.dialog.getStateSync().onAnyChange((key, value) -> {
    traceln("[Java StateSync.onAnyChange] Key modified: " + key + " = " + value);
});
]]></StartupCode>
