						<Parameter>
							<Name><![CDATA[onReady]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[java.util.Map<String, Object> dep = new java.util.LinkedHashMap<>();
dep.put("lat", depot.getLatitude());
dep.put("lng", depot.getLongitude());
webApp.dialog.getBridge().emit("setDepot", dep);]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onMessageReceived]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (type.equals("createOrder")) {
    java.util.Map<String, Object> payload = (java.util.Map<String, Object>) data;
    double lat = ((Number) payload.get("lat")).doubleValue();
    double lng = ((Number) payload.get("lng")).doubleValue();
    String pId = (String) payload.get("id");
    
    vehicle.jumpTo(depot);
    vehicle.orderId = pId;
    vehicle.moveTo(lat, lng);
    traceln("Truck dispatched for order: " + pId);
}
]]></Code>
							</Value>
						</Parameter>
