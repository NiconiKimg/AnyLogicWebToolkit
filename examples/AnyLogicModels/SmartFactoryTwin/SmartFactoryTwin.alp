						<Parameter>
							<Name><![CDATA[onMessageReceived]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (type.equals("addOrder")) {
    addOrder();
} else if (type.equals("toggleAgvHalt")) {
    java.util.Map<String, Object> map = (java.util.Map<String, Object>) data;
    int agvId = ((Number) map.get("agvId")).intValue();
    if (agvId >= 0 && agvId < agvs.size()) {
        AGV a = agvs.get(agvId);
        com.anylogic.libraries.pedestrian.PedExtension pedExt = a.tryExt(com.anylogic.libraries.pedestrian.PedExtension.class);
        if ("HALTED".equals(a.status)) {
            a.status = "IDLE";
            if (pedExt != null) pedExt.setComfortableSpeed(2.0);
        } else {
            a.status = "HALTED";
            if (pedExt != null) pedExt.setComfortableSpeed(0.001);
        }
    }
}]]></Code>
							</Value>
						</Parameter>
