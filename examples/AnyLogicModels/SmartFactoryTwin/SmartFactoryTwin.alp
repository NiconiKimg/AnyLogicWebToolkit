					<Action><![CDATA[// Update battery levels based on current status
if (this.status.equals("IDLE")) {
    this.battery = Math.min(100, this.battery + 0.1);
} else {
    this.battery = Math.max(0, this.battery - uniform(0.01, 0.03));
}]]></Action>
