			<Events>
				<Event>
					<Id>1788373642192</Id>
					<Name><![CDATA[updateWebEvent]]></Name>
					<X>-420</X><Y>110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[0.1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<Id>0</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1788422400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0.1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[0.1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[StringBuilder json = new StringBuilder("{\"agvs\":[");
for(int i = 0; i < agvs.size(); i++) {
    AGV a = agvs.get(i);
    json.append("{")
        .append("\"id\":").append(i).append(",")
        .append("\"x\":").append(a.getX()).append(",")
        .append("\"y\":").append(a.getY()).append(",")
        .append("\"rotation\":").append(a.getRotation()).append(",")
        .append("\"battery\":").append(a.battery).append(",")
        .append("\"status\":\"").append(a.status).append("\"")
        .append("}");
    if (i < agvs.size() - 1) json.append(",");
}

PointNode[] racks = (PointNode[]) this.myRacks;
PointNode[] docks = (PointNode[]) this.myDocks;
RectangularNode[] walls = (RectangularNode[]) this.myWalls;

json.append("], \"layout\": { \"racks\": [");
for(int i=0; i<racks.length; i++) {
    json.append("{\"x\":").append(racks[i].getX()).append(",\"y\":").append(racks[i].getY()).append("}");
    if(i < racks.length - 1) json.append(",");
}
json.append("], \"docks\": [");
for(int i=0; i<docks.length; i++) {
    json.append("{\"x\":").append(docks[i].getX()).append(",\"y\":").append(docks[i].getY()).append("}");
    if(i < docks.length - 1) json.append(",");
}
json.append("], \"walls\": [");
for(int i=0; i<walls.length; i++) { 
    json.append("{\"x\":").append(walls[i].getX()).append(",\"y\":").append(walls[i].getY())
        .append(",\"width\":").append(walls[i].getWidth()).append(",\"height\":").append(walls[i].getHeight())
        .append(",\"rotation\":").append(walls[i].getRotation()).append("}");
    if(i < walls.length - 1) json.append(",");
}
json.append("]}, \"metrics\": { \"activeOrders\": ").append(this.activeOrders)
    .append(", \"ordersCompleted\": ").append(this.ordersCompleted).append(" }}");

if (webApp != null && webApp.dialog != null && webApp.dialog.getBridge() != null) {
    webApp.dialog.getBridge().execute("if(window.updateSimulationData) window.updateSimulationData(" + json.toString() + ");");
}
]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1788373624780</Id>
					<Name><![CDATA[addOrder]]></Name>
					<X>-420</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (waitIdle.size() > 0) {
    this.activeOrders += 1;
    AGV a = waitIdle.getPeds().iterator().next();
    a.assignedRack = ((PointNode[]) this.myRacks)[uniform_discr(0, 5)];
    a.assignedDock = ((PointNode[]) this.myDocks)[uniform_discr(0, 1)];
    waitIdle.free(a);
}
]]></Body>
				</Function>
			</Functions>
